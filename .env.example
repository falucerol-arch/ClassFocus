# PostgreSQL / API de ClassFocus
DATABASE_URL=postgresql://classfocus:classfocus123@localhost:5432/classfocus
DATABASE_SSL=false
API_PORT=8788
API_HOST=127.0.0.1
VITE_API_URL=http://localhost:8788/api
FRONTEND_URL=http://localhost:5173

# Google Classroom: secretos exclusivos del backend; nunca usar el prefijo VITE_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8788/api/classroom/callback
# Generar una sola vez: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Conservar esta clave: cambiarla impide descifrar las conexiones existentes.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Opcional: URL embebible de Google Forms o Microsoft Forms para el examen
VITE_FORMS_URL=

# Opcional. Si se omite, ClassFocus usa ws://<host>:8787
VITE_SIGNALING_URL=
SIGNALING_PORT=8787
